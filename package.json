{
  "name": "chrct",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.mcp-app.json && vite build && vite build --config vite.mcp-app.config.ts",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "desktop:web": "npm run electron:web",
    "desktop:ui": "npm run electron:ui",
    "desktop:dev": "npm run electron:dev",
    "desktop:build": "npm run electron:build",
    "electron:web": "vite --config vite.electron.config.ts",
    "electron:ui": "tsc -p tsconfig.electron.json && vite build --config vite.electron.config.ts",
    "electron:runtime": "npm run electron:ui && node desktop/electron/build.mjs",
    "electron:dev": "electron .electron-build --dev",
    "electron:build": "npm run electron:runtime && node desktop/electron/package.mjs",
    "electron:production:check": "node desktop/electron/build.mjs --production --check",
    "electron:production:build": "node desktop/electron/build.mjs --production --renderer && node desktop/electron/package.mjs --production",
    "electron:release:check": "node desktop/electron/build.mjs --production --release --check",
    "electron:release:build": "node desktop/electron/build.mjs --production --release --renderer && node desktop/electron/package.mjs --production --release",
    "convex": "convex dev"
  },
  "dependencies": {
    "@clerk/backend": "^3.18.1",
    "@clerk/clerk-react": "^5.59.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "^6.0.0",
    "convex": "^1.31.2",
    "lucide-react": "^0.555.0",
    "mcp-handler": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.11.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@clerk/electron": "^0.0.52",
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^44.7.0",
    "electron-store": "^8.2.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "node-pty": "^1.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-singlefile": "^2.3.3",
    "@types/web-push": "^3.6.4"
  }
}
