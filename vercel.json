{
  "functions": {
    "api/mcp.ts": {
      "includeFiles": "dist-mcp/index.html"
    }
  },
  "headers": [
    {
      "source": "/notifications-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/count",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "chrct.com"
        }
      ],
      "destination": "https://terminal.bizencore.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.chrct.com"
        }
      ],
      "destination": "https://terminal.bizencore.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path((?!(?:mcp|api|grok-bot|\\.well-known)(?:/|$)|(?:notifications-sw\\.js|version\\.json)$).*)",
      "has": [
        {
          "type": "host",
          "value": "app.bizencore.com"
        }
      ],
      "destination": "https://terminal.bizencore.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/grok-bot/mcp/:assignment",
      "destination": "/api/grok-bot?assignment=:assignment"
    },
    {
      "source": "/grok-bot/:kind(token|register)/:assignment",
      "destination": "/api/grok-bot-oauth?kind=:kind&assignment=:assignment"
    },
    {
      "source": "/.well-known/oauth-protected-resource/grok-bot/mcp/:assignment",
      "destination": "/api/grok-bot-oauth?kind=mcp&assignment=:assignment"
    },
    {
      "source": "/.well-known/oauth-authorization-server/grok-bot/oauth/:assignment",
      "destination": "/api/grok-bot-oauth?kind=oauth&assignment=:assignment"
    },
    {
      "source": "/grok-bot/oauth/:assignment/.well-known/oauth-authorization-server",
      "destination": "/api/grok-bot-oauth?kind=oauth&assignment=:assignment"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth-authorization-server"
    },
    {
      "source": "/((?!api/|notifications-sw\\.js$).*)",
      "destination": "/index.html"
    }
  ]
}
